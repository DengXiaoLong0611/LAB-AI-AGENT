DEEPSEEK_API_KEY=写入deepseek的API Key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选，纯文本解析和 ReAct 使用 TEXT_*，图片解析使用 VISION_*。
# 留空时继承上面的 DeepSeek 配置，当前 deepseek-flash 支持视觉。
TEXT_MODEL=
TEXT_API_KEY=
TEXT_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
VISION_BASE_URL=

# ---- 风扇真链路（王凯 set_fan_field 接入） ----
# 串口占位（Mac 实测改成 /dev/cu.usbserial-* 或 /dev/tty.*）
FAN_SERIAL_PORT=COM16
# 虚拟验证保持 1；实验室联调改 0
FAN_DRY_RUN=1
